<ProxyEndpoint name="default">
  <PreFlow>
    <Request>
      <Step><Name>VA-verifyClientId</Name></Step>
    </Request>
    <Response>
      <!-- <Step><Name>QA-checkQuota</Name></Step> -->
    </Response>
  </PreFlow>

  <HTTPProxyConnection>
    <!-- Add a base path to the proxy to distinguish from others in the environment -->
    <BasePath>/mocktarget_key</BasePath>
    <!-- Listen on both HTTP and HTTPS endpoints -->
    <VirtualHost>default</VirtualHost>
    <VirtualHost>secure</VirtualHost>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <!-- This connects our proxy to the target defined elsewhere -->
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>